{
  "name": "commercial-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "preview": "vite preview",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "copy-to-vercel": "node --env-file=.env.vercel scripts/copy-to-vercel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@vercel/blob": "^2.8.2",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
