# Copy this file to .env and add your key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a workspace (Console → Settings → Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Sign-in. Create the hash with:
#   node -e 'const c=require("node:crypto"),s=c.randomBytes(16).toString("hex");console.log(s+":"+c.scryptSync(process.argv[1],s,64).toString("hex"))' 'your-password'
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
# Any long random string; keeps people signed in across server restarts.
SESSION_SECRET=
# Set by Vercel when you connect Neon and Blob storage. Leave unset to keep data in server/data.
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
